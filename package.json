{
  "name": "dsh-remote-gpu-switch",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Shows the free GPUs of the machine the current workspace belongs to — this host for a local workspace, the bound SSH host for a remote one — with per-GPU utilization, memory, temperature and owning user, plus a remote_gpu tool.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "gpu",
    "nvidia",
    "rocm",
    "apple-silicon",
    "mps",
    "cuda",
    "local",
    "remote",
    "workspace",
    "monitoring",
    "dsh-remote"
  ],
  "homepage": "https://github.com/Yezery/dsh-remote-gpu-switch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yezery/dsh-remote-gpu-switch.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node tools/test-parse.mjs && node tools/test-targets.mjs && node tools/test-host.mjs && sh tools/check-command.sh"
  }
}
